#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if [ ! -f /etc/dtun/dtun.conf ] && [ -f /etc/dtun/dtun-example.conf ]; then
        echo "[dtun] Initializing /etc/dtun/dtun.conf from template..."
        cp /etc/dtun/dtun-example.conf /etc/dtun/dtun.conf
    fi

    echo "[dtun] Updating kernel module dependencies with depmod..."
    depmod -a || true
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
    fi
fi

#DEBHELPER#

exit 0
