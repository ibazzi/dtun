PACKAGE_NAME="dtun"
PACKAGE_VERSION="@VERSION@"
BUILT_MODULE_NAME[0]="dtun"
BUILT_MODULE_LOCATION[0]="module/"
DEST_MODULE_LOCATION[0]="/updates"
AUTOINSTALL="yes"

MAKE[0]="make -C $kernel_source_dir M=$dkms_tree/$PACKAGE_NAME/$PACKAGE_VERSION/build/module modules"
CLEAN="make -C $kernel_source_dir M=$dkms_tree/$PACKAGE_NAME/$PACKAGE_VERSION/build/module clean"
