#!/bin/sh
set -e

MODULE=dtun
VERSION=@VERSION@

case "$1" in
    remove|upgrade|deconfigure)
        if command -v dkms >/dev/null 2>&1; then
            dkms remove -m "$MODULE" -v "$VERSION" --all || true
        fi
        ;;
    failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
